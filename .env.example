# Copy to .env (repo root) and fill in. Never commit .env.

# Required for live extraction/verification. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs change often. Verify what your key can use with:
#   python scripts/list_models.py
YOUVERIFY_EXTRACTION_MODEL=gemini-3.8-flash
YOUVERIFY_VERIFICATION_MODEL=gemini-3.8-flash

# Video window sent to Gemini around the click (seconds before / after).
YOUVERIFY_WINDOW_BEFORE_SEC=45
YOUVERIFY_WINDOW_AFTER_SEC=10
# Frames per second sampled from the clip, and frame resolution. Speech matters
# most for claim extraction, so low values keep cost down.
YOUVERIFY_VIDEO_FPS=0.5
YOUVERIFY_VIDEO_MEDIA_RESOLUTION=low

YOUVERIFY_TIMEOUT_SEC=90
YOUVERIFY_MAX_RETRIES=2
YOUVERIFY_RATE_LIMIT_PER_MINUTE=20
YOUVERIFY_CACHE_TTL_SEC=3600
# Resolve Google grounding redirect links to publisher URLs (contacts only
# vertexaisearch.cloud.google.com, never follows redirects).
YOUVERIFY_RESOLVE_REDIRECTS=true

# CORS: restrict to your unpacked extension's ID once you know it (chrome://extensions).
YOUVERIFY_ALLOWED_ORIGIN_REGEX=^chrome-extension://[a-p]{32}$

# Optional: USD per 1M tokens for cost estimates in responses. Check current
# pricing at https://ai.google.dev/gemini-api/docs/pricing. Leave empty to disable.
YOUVERIFY_PRICE_INPUT_PER_M=
YOUVERIFY_PRICE_OUTPUT_PER_M=

YOUVERIFY_LOG_LEVEL=INFO
