# Copy to .env (repo root) and fill in. Never commit .env.

# Required for live extraction/verification. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs change often. Verify what your key can use with:
#   python scripts/list_models.py
YOUVERIFY_EXTRACTION_MODEL=gemini-3.8-flash
YOUVERIFY_VERIFICATION_MODEL=gemini-3.8-flash
# Optional: tried once per call, only when the model above is overloaded (HTTP 503).
# Quota (429) errors never fall back. Responses record which model served each step.
YOUVERIFY_FALLBACK_MODEL=gemini-3.6-flash
# Daily cap on Gemini requests per backend process (resets 00:00 UTC). Each fallback
# attempt counts. Set it before any shared deployment; also bounds live experiments.
YOUVERIFY_GEMINI_DAILY_CALL_LIMIT=

# Video window sent to Gemini around the click (seconds before / after).
YOUVERIFY_WINDOW_BEFORE_SEC=45
YOUVERIFY_WINDOW_AFTER_SEC=10
# Frames per second sampled from the clip, and frame resolution. Speech matters
# most for claim extraction, so low values keep cost down.
YOUVERIFY_VIDEO_FPS=0.5
YOUVERIFY_VIDEO_MEDIA_RESOLUTION=low

YOUVERIFY_TIMEOUT_SEC=90
YOUVERIFY_MAX_RETRIES=2
YOUVERIFY_RATE_LIMIT_PER_MINUTE=20
YOUVERIFY_CACHE_TTL_SEC=3600
# Resolve Google grounding redirect links to publisher URLs (contacts only
# vertexaisearch.cloud.google.com, never follows redirects).
YOUVERIFY_RESOLVE_REDIRECTS=true

# CORS: restrict to your unpacked extension's ID once you know it (chrome://extensions).
YOUVERIFY_ALLOWED_ORIGIN_REGEX=^chrome-extension://[a-p]{32}$

# Optional: USD per 1M tokens for cost estimates in responses. Check current
# pricing at https://ai.google.dev/gemini-api/docs/pricing. Leave empty to disable.
YOUVERIFY_PRICE_INPUT_PER_M=
YOUVERIFY_PRICE_OUTPUT_PER_M=
# Grounding with Google Search is billed per executed search query on Gemini 3.
YOUVERIFY_PRICE_PER_1K_SEARCHES=

# Evidence retrieval (see docs/retrieval-architecture.md).
#   gemini_grounding (default): Gemini + Google Search grounding. Needs only GEMINI_API_KEY.
#   search: the providers below, in order; pages are fetched and quoted on the backend.
YOUVERIFY_RETRIEVAL_BACKEND=gemini_grounding
# Recommended for public deployment: brave. SearXNG is for evaluation (see the doc's limitations).
YOUVERIFY_SEARCH_PROVIDERS=brave
# Private SearXNG instance with JSON output enabled (search.formats: [html, json]).
# Never use a public instance.
YOUVERIFY_SEARXNG_URL=
# Brave Search API key (backend only, never put it in the extension).
BRAVE_SEARCH_API_KEY=
# Paid search is refused unless BOTH a price and a daily cap are set.
# USD per 1000 Brave requests, from Brave's current price list.
YOUVERIFY_PRICE_PER_1K_BRAVE=
# Hard daily cap (USD, resets 00:00 UTC, per backend process) for all paid search.
YOUVERIFY_SEARCH_DAILY_BUDGET_USD=
# A paid provider listed after another one (e.g. searxng,brave) is an automatic paid
# fallback; it is refused unless this is true.
YOUVERIFY_ALLOW_PAID_SEARCH_FALLBACK=false
YOUVERIFY_SEARCH_TIMEOUT_SEC=8
# Skip a provider for COOLDOWN seconds after FAILURES consecutive errors.
YOUVERIFY_SEARCH_FAILURES=3
YOUVERIFY_SEARCH_COOLDOWN_SEC=60
YOUVERIFY_PAGES_TO_FETCH=6

YOUVERIFY_LOG_LEVEL=INFO
